---
const enabled = import.meta.env.PROD;
---
{enabled && (
  <>
    <script is:inline async src="https://stats.blackholeenglish.com/js/pa-SrqWkZG1nlPuPTtAm1TeR.js"></script>
    <script is:inline>
      // Keep development and deployment previews out of production statistics.
      if (window.location.hostname === 'calcsolver.info') {
        window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
        plausible.init();
      }
    </script>
  </>
)}
