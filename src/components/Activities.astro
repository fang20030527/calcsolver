<dialog id="activities" class="activities" aria-label="Activities">
  <div class="activities-topbar">
    <button id="back-to-activities" class="vault-button" hidden>← All Activities</button>
    <div class="activity-search-wrap" id="activity-search-wrap"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><label class="sr-only" for="activity-search">Search activities</label><input id="activity-search" type="search" placeholder="Search activities…" autocomplete="off" /></div>
    <h2 id="player-title" hidden></h2>
    <span class="vault-brand">CalcSolver<span>.info</span></span>
    <button id="exit-activities" class="vault-button exit-button">Exit <span aria-hidden="true">↗</span></button>
  </div>
  <div id="activity-browser">
    <div class="source-bar"><label for="activity-source">Activity source</label><select id="activity-source"><option value="all">All activities</option><option value="local">Local games</option></select><span id="activity-count" aria-live="polite"></span></div>
    <div class="activity-grid" id="activity-grid"></div>
    <div class="activity-empty" id="activity-empty" hidden><span aria-hidden="true">⌕</span><h3>No activities found</h3><p>Try another name or a four-digit code.</p><button id="clear-search" class="vault-button">Clear search</button></div>
    <p class="vault-bottom-note">Take a little break. Discover something new.<span>External activities are provided by third parties.</span></p>
  </div>
  <section id="activity-player" class="activity-player" aria-label="Game player" hidden>
    <div class="player-toolbar"><span id="player-provider"></span><a id="open-game-link" href="/" target="_blank" rel="noopener noreferrer">Open in new tab ↗</a><button id="retry-game">↻ Reload</button><button id="fullscreen-game">⛶ Fullscreen</button></div>
    <div class="player-layout"><aside class="player-recommendations" id="player-recommendations" aria-label="More activities"></aside><div class="game-frame-wrap" id="game-frame-wrap"><div class="game-load-status" id="game-load-status" role="status"><span class="loading-ring"></span><h3>Loading activity…</h3><p>The player will appear here.</p><button id="dismiss-game-status" hidden>Show player</button></div><iframe id="game-frame" title="Activity player" allow="fullscreen; autoplay; gamepad" referrerpolicy="strict-origin-when-cross-origin" sandbox="allow-scripts allow-same-origin allow-pointer-lock allow-forms allow-popups allow-downloads"></iframe></div></div>
    <p class="player-note">Having trouble? Reload or open the activity in a new tab. External availability can vary.</p>
  </section>
</dialog>
<script>
  import '../scripts/activities';
</script>
