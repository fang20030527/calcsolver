---
import { site, categories } from '../data/site';
import FontLinks from '../components/FontLinks.astro';
import { canonicalUrl, pageStructuredData, serializeStructuredData, type Breadcrumb, type StructuredData } from '../lib/seo';
import '../styles/site.css';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  pageType?: 'WebPage' | 'CollectionPage' | 'AboutPage' | 'ContactPage';
  ogType?: 'website' | 'article';
  breadcrumbs?: Breadcrumb[];
  structuredData?: StructuredData[];
}
const { title = 'Free Online Scientific Calculator & Math Guides | CalcSolver', description = site.description, noindex = false, pageType = 'WebPage', ogType = 'website', breadcrumbs = [], structuredData = [] } = Astro.props;
const canonical = canonicalUrl(Astro.url.pathname);
const schema = pageStructuredData(Astro.url.pathname, title, description, pageType, breadcrumbs, structuredData);
const image = `${site.url}/og-image.png`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <FontLinks />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CalcSolver — free online calculator and clear math guides" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="CalcSolver — free online calculator and clear math guides" />
    <meta name="theme-color" content="#f7f7f2" />
    {!noindex && <script type="application/ld+json" is:inline set:html={serializeStructuredData(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <div class="header-brand"><a class="wordmark" href="/" aria-label="CalcSolver home">Calc<span>Solver</span></a><span class="brand-caption">Calculator & math guides</span></div>
        <button class="menu-toggle" aria-controls="primary-navigation" aria-expanded="false" aria-label="Toggle navigation"><span></span><span></span><span></span></button>
        <nav id="primary-navigation" aria-label="Primary">
          {categories.map(category => <a href={`/category/${category.slug}/`} aria-current={Astro.url.pathname.startsWith(`/category/${category.slug}`) ? 'page' : undefined}>{category.name}</a>)}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-brand"><a href="/" class="footer-wordmark">CalcSolver<span>.info</span></a><p>Everyday calculations.<br />A little understanding.</p></div>
        <nav aria-label="Footer"><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy Policy</a></nav>
      </div>
      <div class="footer-bottom"><span>© {new Date().getUTCFullYear()} CalcSolver.info</span><a href="/#calculator">Back to the calculator ↑</a></div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#primary-navigation');
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') !== 'true';
        menu.setAttribute('aria-expanded', String(open));
        navigation?.classList.toggle('is-open', open);
      });
    </script>
  </body>
</html>
