---
import { site, categories } from '../data/site';
import '../styles/site.css';
interface Props { title?: string; description?: string; noindex?: boolean }
const { title = 'CalcSolver | Free Online Calculator & Math Tools', description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={`${site.url}/og-image.svg`} />
    <meta name="theme-color" content="#f7f7f2" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <div class="header-brand"><a class="wordmark" href="/" aria-label="CalcSolver home">Calc<span>Solver</span></a><span class="brand-caption">Calculator & math guides</span></div>
        <button class="menu-toggle" aria-controls="primary-navigation" aria-expanded="false" aria-label="Toggle navigation"><span></span><span></span><span></span></button>
        <nav id="primary-navigation" aria-label="Primary">
          {categories.map(category => <a href={`/category/${category.slug}/`} aria-current={Astro.url.pathname.startsWith(`/category/${category.slug}`) ? 'page' : undefined}>{category.name}</a>)}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-brand"><a href="/" class="footer-wordmark">CalcSolver<span>.info</span></a><p>Everyday calculations.<br />A little understanding.</p></div>
        <nav aria-label="Footer"><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy Policy</a></nav>
      </div>
      <div class="footer-bottom"><span>© {new Date().getUTCFullYear()} CalcSolver.info</span><a href="/#calculator">Back to the calculator ↑</a></div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#primary-navigation');
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') !== 'true';
        menu.setAttribute('aria-expanded', String(open));
        navigation?.classList.toggle('is-open', open);
      });
    </script>
  </body>
</html>
